export DIST_NAME="ChipBit"
export DIST_VERSION="0.1.0"

# base must be the parent module — it sets BASE_ROOT_PARTITION, mounts the
# image, configures QEMU, and runs child modules inside the chroot.
export MODULES="base(chipbit)"

# BASE_ARCH=arm64 is set in config.local (highest-priority override) rather
# than here. Setting BASE_BOARD=raspberrypiarm64 in this file would cause
# modules/base/config to unconditionally blank BASE_ZIP_IMG via a directory
# glob, so we leave BASE_BOARD at its default and let config.local own arch.

# Extra space added to the root partition before the chroot runs.
# Needs to cover: cage, scummvm, chromium, dosbox, GCompris, Tuxpaint,
# python3, chipbit, and their deps.  3 GB is a safe margin.
[ -n "$BASE_IMAGE_ENLARGEROOT" ] || BASE_IMAGE_ENLARGEROOT=3000

# After the build, shrink back to used space + this headroom (MB).
# Leaves ~500 MB free on first boot for cards.yaml, apt cache, etc.
[ -n "$BASE_IMAGE_RESIZEROOT" ] || BASE_IMAGE_RESIZEROOT=500
