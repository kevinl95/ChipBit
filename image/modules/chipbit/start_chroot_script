#!/usr/bin/env bash
# ChipBit CustomPiOS module — runs inside the image chroot.
# Installs engines, creates the kiosk user, installs ChipBit, enables services.
set -euo pipefail

# CustomPiOS stages the module's filesystem/ overlay as /filesystem/ inside the
# chroot (cp -r with no trailing slash copies the dir itself, not its contents).
# Fix ownership before merging: overlay files are owned by the dev user on the
# host, and cp -a preserves that, which would corrupt /etc/, /usr/, etc. inside
# the chroot and break apt's GPG verification.
if [ -d /filesystem ]; then
    chown -R root:root /filesystem
    cp -a /filesystem/. /
    rm -rf /filesystem
fi
chmod +x /usr/share/chipbit/apply_wifi_country.sh

# Load module config (sourced by CustomPiOS before calling this script).
CHIPBIT_VERSION="${CHIPBIT_VERSION:-0.1.0}"
RUFFLE_WEB_VERSION="${RUFFLE_WEB_VERSION:-0.3.0}"
CHIPBIT_UID="${CHIPBIT_UID:-1000}"
CHIPBIT_GID="${CHIPBIT_GID:-1000}"
CHIPBIT_WEB_PORT="${CHIPBIT_WEB_PORT:-8080}"
CHIPBIT_CONTROL_PORT="${CHIPBIT_CONTROL_PORT:-8765}"

# ---------------------------------------------------------------------------
# 1. Base engines and compositor
# ---------------------------------------------------------------------------
# Never prompt for input — we are running fully noninteractive inside qemu.
export DEBIAN_FRONTEND=noninteractive
export DEBCONF_NONINTERACTIVE_SEEN=true

# Ensure /tmp is writable before apt runs.  Pi OS Bookworm mounts /tmp as
# tmpfs at runtime via systemd; in a chroot that service doesn't start, so
# we fix the mode explicitly.
chmod 1777 /tmp

# Prevent apt from hanging indefinitely on a stalled TCP connection.
# 60 s timeout per connection attempt; 3 retries before giving up.
cat > /etc/apt/apt.conf.d/99-chipbit-build <<'EOF'
Acquire::http::Timeout "60";
Acquire::https::Timeout "60";
Acquire::Retries "3";
Acquire::ForceIPv4 "true";
EOF

# Stub out mandb so the man-db dpkg trigger doesn't run under qemu-arm
# emulation (it would grind for tens of minutes rebuilding the index).
# This is a kiosk appliance — man pages are never used at runtime.
dpkg-divert --local --rename --add /usr/bin/mandb > /dev/null 2>&1 || true
ln -sf /bin/true /usr/bin/mandb

# The raspbian.raspberrypi.com CDN uses MirrorBrain to redirect downloads to
# the nearest geographic mirror.  That mirror can lag hours behind on security
# updates, causing 404s even though the package exists.  Pin directly to a
# mirror confirmed to be current, bypassing the CDN redirect entirely.
sed -i 's|http://raspbian.raspberrypi.com/raspbian|http://mirror.fcix.net/raspbian/raspbian|g' \
    /etc/apt/sources.list

# Add the full Debian Bookworm repos for packages not in Raspbian (marble,
# kstars, supertux, supertuxkart, etc.).  archive.raspberrypi.com is already
# present in /etc/apt/sources.list.d/raspi.list so we don't repeat it here.
cat > /etc/apt/sources.list.d/debian-bookworm.list <<'EOF'
deb http://deb.debian.org/debian bookworm main contrib non-free non-free-firmware
deb http://deb.debian.org/debian bookworm-updates main contrib non-free non-free-firmware
deb http://deb.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware
EOF

# Bootstrap the Debian archive keyring.  debian-archive-keyring lives in the
# Debian repos we just added, but we need it to trust those repos — chicken and
# egg.  Fetch the package lists ignoring signatures, install just the keyring
# package unauthenticated (it contains only public key material, not code), then
# all subsequent apt calls are fully signature-verified.
apt-get -o Acquire::AllowInsecureRepositories=true update -qq 2>/dev/null || true
apt-get install -y --no-install-recommends --allow-unauthenticated debian-archive-keyring

# Re-fetch the package index and install.  Retried up to 3 times with a
# 60-second pause in case mirrors are mid-sync on a security update batch.
for _attempt in 1 2 3; do
    apt-get update -y
    apt-get install -y --no-install-recommends \
        cage \
        xwayland \
        dbus \
        chromium-browser \
        fonts-dejavu-core \
        locales \
        python3-installer \
        python3-yaml \
        python3-evdev \
        qtwayland5 \
        pipewire \
        pipewire-pulse \
        wireplumber \
        alsa-utils \
        iw \
        rfkill \
        wireless-regdb \
        curl \
        ca-certificates \
        openssh-server \
        parted \
        scummvm \
        unzip \
    && break
    echo "apt-get install attempt ${_attempt} failed; waiting 60s for mirrors to sync..."
    sleep 60
done

# dosbox-staging is not available in all Pi OS repo flavours (notably armhf).
# Fall back to the original dosbox and symlink it so the launcher service
# always resolves --dosbox-bin dosbox-staging without extra config.
if apt-cache show dosbox-staging > /dev/null 2>&1; then
    apt-get install -y --no-install-recommends dosbox-staging
else
    apt-get install -y --no-install-recommends dosbox
    ln -sf "$(command -v dosbox)" /usr/local/bin/dosbox-staging
fi

# Ruffle (Flash player) — self-hosted web bundle (JS + WASM) rather than
# the desktop binary, which requires glibc 2.39 but Bookworm ships 2.36.
# The launcher opens player.html via file:// with --allow-file-access-from-files
# so no web server is needed to serve SWF files.
# player.html was installed from the filesystem overlay above; unzip -n
# (never overwrite) ensures it is not replaced if the bundle ships one too.
RUFFLE_WEB_URL="https://github.com/ruffle-rs/ruffle/releases/download/v${RUFFLE_WEB_VERSION}/ruffle-${RUFFLE_WEB_VERSION}-web-selfhosted.zip"
echo "Downloading Ruffle web bundle ${RUFFLE_WEB_VERSION}..."
mkdir -p /usr/share/chipbit/ruffle
if curl -fsSL "${RUFFLE_WEB_URL}" -o /tmp/ruffle-web.zip; then
    unzip -qn /tmp/ruffle-web.zip -d /usr/share/chipbit/ruffle/
    rm -f /tmp/ruffle-web.zip
    echo "Ruffle web bundle installed at /usr/share/chipbit/ruffle/"
else
    echo "Warning: Ruffle web bundle download failed — Flash titles will not work."
fi

# ---------------------------------------------------------------------------
# 2. Bundled native titles (from catalog — single source of truth)
# ---------------------------------------------------------------------------
CATALOG=/usr/share/chipbit/catalog.yaml
HELPER=/usr/share/chipbit/emit_bundled_apt.py
BUNDLED_PKGS="$(python3 "${HELPER}" "${CATALOG}")"
if [ -n "${BUNDLED_PKGS}" ]; then
    # shellcheck disable=SC2086
    apt-get install -y --no-install-recommends ${BUNDLED_PKGS}
fi

# ---------------------------------------------------------------------------
# 2a. Catalog artwork — fetch icons for all titles
# ---------------------------------------------------------------------------
# Icons are pulled from package files (already on disk for bundled titles, or
# downloaded via apt for non-bundled ones) so no binary files live in the repo.
# Any title without art here shows the built-in default SVG at runtime.
mkdir -p /usr/share/chipbit/art

_art_from_installed() {
    # Try standard on-disk icon paths; return 1 if none found so callers can
    # fall back to _art_from_deb.
    local artname="$1" pkg="$2"
    local size src
    for size in 256x256 128x128 64x64 48x48; do
        for name in "${artname}" "${pkg}"; do
            src="/usr/share/icons/hicolor/${size}/apps/${name}.png"
            if [ -f "$src" ]; then
                cp "$src" "/usr/share/chipbit/art/${artname}.png"
                return 0
            fi
        done
    done
    for name in "${artname}" "${pkg}"; do
        src="/usr/share/pixmaps/${name}.png"
        if [ -f "$src" ]; then
            cp "$src" "/usr/share/chipbit/art/${artname}.png"
            return 0
        fi
    done
    return 1
}

_art_from_deb() {
    # Download a package's .deb and extract its highest-resolution icon.
    # Every find/ls is guarded with || true so set -e can't fire on a missing dir.
    local artname="$1" pkg="$2"
    local tmpdir icon deb size
    tmpdir="$(mktemp -d)"
    (cd "$tmpdir" && apt-get download "${pkg}" 2>/dev/null) || true
    deb="$(ls "${tmpdir}"/*.deb 2>/dev/null | head -1)" || true
    if [ -n "$deb" ]; then
        dpkg -x "$deb" "${tmpdir}/u/" 2>/dev/null || true
        icon=""
        for size in 256x256 128x128 64x64 48x48; do
            icon="$(find "${tmpdir}/u/usr/share/icons/hicolor/${size}/apps/" \
                    -name "*.png" 2>/dev/null | head -1)" || true
            if [ -n "$icon" ]; then break; fi
        done
        if [ -z "$icon" ]; then
            icon="$(find "${tmpdir}/u/usr/share/pixmaps/" \
                    -name "*.png" 2>/dev/null | head -1)" || true
        fi
        if [ -n "$icon" ]; then
            cp "$icon" "/usr/share/chipbit/art/${artname}.png"
        else
            echo "Warning: no icon extracted from ${pkg}"
        fi
    else
        echo "Warning: apt-get download failed for ${pkg}"
    fi
    rm -rf "$tmpdir"
}

# Extract artwork for every catalog title that has an apt install spec.
# emit_title_art.py outputs "<id> <first-apt-package>" for each such title.
# Try on-disk icons first (fast, no download); fall back to downloading the deb.
# Adding a new catalog title requires no changes here.
ART_HELPER=/usr/share/chipbit/emit_title_art.py
while IFS=' ' read -r _artname _pkg; do
    _art_from_installed "${_artname}" "${_pkg}" \
        || _art_from_deb "${_artname}" "${_pkg}"
done < <(python3 "${ART_HELPER}" "${CATALOG}")
unset _artname _pkg

# ---------------------------------------------------------------------------
# 3. Kiosk system user
# ---------------------------------------------------------------------------
# Pi OS Bookworm base images pre-create a 'pi' user/group at UID/GID 1000.
# Remove it before creating chipbit so there is no GID/UID collision.
if getent passwd pi > /dev/null; then
    userdel -r pi 2>/dev/null || true
fi
if getent group pi > /dev/null; then
    groupdel pi 2>/dev/null || true
fi

if ! getent group chipbit > /dev/null; then
    groupadd --gid "${CHIPBIT_GID}" chipbit
fi

if ! id chipbit &> /dev/null; then
    useradd \
        --uid "${CHIPBIT_UID}" \
        --gid "${CHIPBIT_GID}" \
        --create-home \
        --shell /bin/bash \
        --comment "ChipBit kiosk user" \
        chipbit
fi

# Fix ownership of the entire home directory (cp -a above created it as root:root).
chown -R chipbit:chipbit /home/chipbit
chmod 700 /home/chipbit

# Pre-create XDG base directories so launched apps can write their data on
# first run.  Apps that use legacy ~/.appname paths will create those themselves
# as long as HOME is set correctly in the launcher service environment.
mkdir -p /home/chipbit/.config \
         /home/chipbit/.local/share \
         /home/chipbit/.cache \
         /home/chipbit/.tuxpaint
chown -R chipbit:chipbit /home/chipbit/.config \
                         /home/chipbit/.local \
                         /home/chipbit/.cache \
                         /home/chipbit/.tuxpaint

# Set a recovery password so the console is accessible if the kiosk fails.
# Override at build time with CHIPBIT_PASSWORD env var; default is "chipbit".
echo "chipbit:${CHIPBIT_PASSWORD:-chipbit}" | chpasswd

# Allow the chipbit web service to change the keyboard layout without a
# password prompt.  Scoped to a single specific command — not broad sudo.
echo "chipbit ALL=(ALL) NOPASSWD: /usr/bin/localectl set-x11-keymap *" \
    > /etc/sudoers.d/chipbit-localectl
chmod 0440 /etc/sudoers.d/chipbit-localectl

# Generating a locale needs root.  The script validates its argument against
# /usr/share/i18n/SUPPORTED before doing anything, so the web form cannot ask
# for an arbitrary string.
echo "chipbit ALL=(ALL) NOPASSWD: /usr/share/chipbit/apply_locale.sh *" \
    > /etc/sudoers.d/chipbit-locale
chmod 0440 /etc/sudoers.d/chipbit-locale
chmod 0755 /usr/share/chipbit/apply_locale.sh

# Allow WiFi management from the web service (a system service with no logind
# session, so polkit blocks nmcli without this).  Scoped to the exact
# subcommands needed — connect, radio toggle, rfkill unblock.
cat > /etc/sudoers.d/chipbit-nmcli <<'EOF'
chipbit ALL=(root) NOPASSWD: /usr/bin/nmcli *
chipbit ALL=(root) NOPASSWD: /usr/bin/rfkill unblock wifi
EOF
chmod 0440 /etc/sudoers.d/chipbit-nmcli

# Allow on-demand package installation (e.g. Marble, KStars) from the launcher.
cat > /etc/sudoers.d/chipbit-apt <<'EOF'
Defaults!/usr/bin/apt-get env_keep += "DEBIAN_FRONTEND"
chipbit ALL=(root) NOPASSWD: /usr/bin/apt-get update *
chipbit ALL=(root) NOPASSWD: /usr/bin/apt-get install *
# Recover from a dpkg interrupted mid-transaction (a reboot during an install).
# Exact match, no wildcard: `dpkg -i` on an arbitrary path would be root.
chipbit ALL=(root) NOPASSWD: /usr/bin/dpkg --configure -a
EOF
chmod 0440 /etc/sudoers.d/chipbit-apt

# Allow the web service to restart systemd-timesyncd after WiFi connects,
# so the clock syncs before any apt operations run during enrollment.
cat > /etc/sudoers.d/chipbit-timesyncd <<'EOF'
chipbit ALL=(root) NOPASSWD: /usr/bin/systemctl restart systemd-timesyncd
EOF
chmod 0440 /etc/sudoers.d/chipbit-timesyncd

# Allow restarting the chipbit services (useful for development iteration
# and future in-place update support).
cat > /etc/sudoers.d/chipbit-services <<'EOF'
chipbit ALL=(root) NOPASSWD: /usr/bin/systemctl restart chipbit-web
chipbit ALL=(root) NOPASSWD: /usr/bin/systemctl restart chipbit-launcher
EOF
chmod 0440 /etc/sudoers.d/chipbit-services

cat > /etc/sudoers.d/chipbit-power <<'EOF'
chipbit ALL=(root) NOPASSWD: /usr/sbin/shutdown -h now
chipbit ALL=(root) NOPASSWD: /usr/bin/systemctl reboot
chipbit ALL=(root) NOPASSWD: /usr/share/chipbit/apply_wifi_country.sh
EOF
chmod 0440 /etc/sudoers.d/chipbit-power

# Allow the web service to read system journal entries for diagnostics.
cat > /etc/sudoers.d/chipbit-logs <<'EOF'
chipbit ALL=(root) NOPASSWD: /usr/bin/journalctl *
EOF
chmod 0440 /etc/sudoers.d/chipbit-logs

# Grant groups needed for evdev, audio, and GPU access.
# adm: read system journal without sudo.  sudo: recovery access.
for grp in input audio video tty seat render adm sudo netdev systemd-journal; do
    if getent group "${grp}" > /dev/null; then
        usermod -aG "${grp}" chipbit
    fi
done

# Enable PipeWire audio as a user service for the chipbit account.
# PipeWire (and its session manager wireplumber) run per-user under systemd
# --user; enabling them here means they start automatically on login.
systemctl --global enable \
    pipewire.socket pipewire.service \
    pipewire-pulse.socket pipewire-pulse.service \
    wireplumber.service \
    2>/dev/null || true

# Enable linger so systemd starts the chipbit user instance at boot, not only on
# interactive login.  chipbit-kiosk pre-creates /run/user/1000 but without linger
# the user services (PipeWire) never start, so SDL2/TuxPaint can't find audio.
mkdir -p /var/lib/systemd/linger
touch /var/lib/systemd/linger/chipbit

# Allow the chipbit web service to trigger WiFi scans and manage connections via
# NetworkManager without a polkit interactive session.  As a system service the
# chipbit process has no logind session, so without this rule nmcli --rescan yes
# is denied and "No network with SSID found" errors occur on every connect attempt.
mkdir -p /etc/polkit-1/rules.d
cat > /etc/polkit-1/rules.d/50-chipbit-network.rules <<'EOF'
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.NetworkManager") === 0 &&
            subject.user === "chipbit") {
        return polkit.Result.YES;
    }
});
EOF

# Allow chipbit to mount removable media (USB drives, optical discs) via
# udisks2 without an interactive logind seat.  Without this, udisksctl mount
# is denied because the service user has no active seat.
cat > /etc/polkit-1/rules.d/50-chipbit-media.rules <<'EOF'
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.udisks2.filesystem-mount") === 0 &&
            subject.user === "chipbit") {
        return polkit.Result.YES;
    }
});
EOF

# ---------------------------------------------------------------------------
# Kiosk: the autologin.conf drop-in (already in the filesystem overlay) makes
# getty@tty1 autologin as the chipbit user.  .bash_profile detects tty1 and
# launches cage → chromium.  The getty session gives cage a proper logind
# seat and XDG_RUNTIME_DIR automatically — no separate kiosk service needed.

# Mask Pi OS first-boot services that conflict with our pre-created user.
for svc in \
    userconfig.service \
    userconfig.path \
    raspi-config.service \
    NetworkManager-wait-online.service \
    systemd-networkd-wait-online.service; do
    systemctl mask "${svc}" 2>/dev/null || true
done

# ---------------------------------------------------------------------------
# 4. Hostname and runtime directories
# ---------------------------------------------------------------------------
echo "chipbit" > /etc/hostname
sed -i 's/raspberrypi/chipbit/g' /etc/hosts 2>/dev/null || true

# Disable the dump_obss firmware feature (0x82000) which causes chanspec
# failures when the driver tries to switch to a 2.4 GHz channel, leaving the
# radio stuck on 5 GHz only.  roamoff=1 lets the OS handle roaming decisions
# rather than the firmware.  This matches the config used by Home Assistant OS.
cat > /etc/modprobe.d/brcmfmac.conf <<'EOF'
options brcmfmac roamoff=1 feature_disable=0x82000
EOF

# WiFi country code is chosen by the user during first-run setup and applied by
# apply_wifi_country.sh (installed via the filesystem overlay).  The script
# patches brcmfmac NVRAM files, writes cfg80211 module params, writes a udev
# rule, and calls iw reg set — all at runtime so a single image works worldwide.
cat > /etc/systemd/system/chipbit-wifi-country.service <<'EOF'
[Unit]
Description=Apply ChipBit WiFi country regulatory settings
Before=NetworkManager.service wpa_supplicant.service
DefaultDependencies=no
ConditionPathExists=/var/lib/chipbit/wifi_country

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/share/chipbit/apply_wifi_country.sh

[Install]
WantedBy=sysinit.target
EOF
systemctl enable chipbit-wifi-country.service

# Pi OS base images can ship NetworkManager with managed=false (a legacy flag
# that hands WiFi to dhcpcd/wpa_supplicant instead).  Force managed=true so
# nmcli can scan and connect — without this, device wifi list returns nothing.
mkdir -p /etc/NetworkManager/conf.d
cat > /etc/NetworkManager/conf.d/10-chipbit.conf <<'EOF'
[main]
plugins=keyfile

[ifupdown]
managed=true
EOF

# NM persists radio state in this file.  Seeding it with WifiEnabled=true
# prevents the radio starting soft-blocked on first boot (seen on Pi 400 when
# no country code was set during initial image flash).
mkdir -p /var/lib/NetworkManager
cat > /var/lib/NetworkManager/NetworkManager.state <<'EOF'
[main]
NetworkingEnabled=true
WifiEnabled=true
WWANEnabled=true
EOF

mkdir -p /var/lib/chipbit
chown chipbit:chipbit /var/lib/chipbit
chmod 0755 /var/lib/chipbit

mkdir -p /games
chown chipbit:chipbit /games
chmod 0755 /games

# ---------------------------------------------------------------------------
# 5. Install ChipBit from the pre-built wheel staged by build_dist
# ---------------------------------------------------------------------------
# The wheel was built on the host and landed in the filesystem overlay at
# filesystem/tmp/; after the overlay merge it's at /tmp/chipbit-*.whl.
python3 -m installer /usr/share/chipbit/chipbit-*.whl
rm -f /usr/share/chipbit/chipbit-*.whl

# ---------------------------------------------------------------------------
# 6. Enable systemd services
# ---------------------------------------------------------------------------
chmod 755 /usr/local/sbin/chipbit-expand-rootfs
chmod 755 /usr/local/bin/supertuxkart-x11
chmod 755 /usr/local/bin/tuxpaint-x11
systemctl enable chipbit-expand-rootfs.service
systemctl enable chipbit-xwayland.service
systemctl enable chipbit-kiosk.service
systemctl enable chipbit-launcher.service
systemctl enable chipbit-web.service

# Sentinel that tells chipbit-expand-rootfs to run on first boot.
# Deleted by the script after it resizes; subsequent boots skip it.
touch /var/lib/chipbit/.rootfs-needs-expand
# Mask getty@tty1 — chipbit-kiosk.service owns VT1 via PAMName=login + TTYPath.
systemctl mask getty@tty1.service

# Enable SSH for remote diagnostics.
# Allow password auth so the chipbit user is reachable without a key.
systemctl enable ssh
sed -i \
    -e 's/^#\?PasswordAuthentication .*/PasswordAuthentication yes/' \
    -e 's/^#\?ChallengeResponseAuthentication .*/ChallengeResponseAuthentication no/' \
    /etc/ssh/sshd_config

# ---------------------------------------------------------------------------
# 7. Strip the Pi OS firstboot hook from cmdline.txt
# ---------------------------------------------------------------------------
# The base image ships with init=/usr/lib/raspberrypi-sys-mods/firstboot which
# prompts to create a user on first boot.  Our chroot already creates the chipbit
# user and sets everything up, so skip firstboot entirely.
# CustomPiOS mounts the boot partition at /boot/firmware/ inside the chroot.
for CMDLINE_PATH in /boot/firmware/cmdline.txt /boot/cmdline.txt; do
    if [ -f "${CMDLINE_PATH}" ]; then
        sed -i 's| init=/usr/lib/raspberrypi-sys-mods/firstboot||g' "${CMDLINE_PATH}"
        sed -i 's/ quiet//' "${CMDLINE_PATH}"
        echo "Stripped firstboot and quiet from ${CMDLINE_PATH}"
    fi
done

# ---------------------------------------------------------------------------
# 8. Clean up
# ---------------------------------------------------------------------------
apt-get clean
rm -rf /var/lib/apt/lists/*
# Remove the saved timesync timestamp so the Pi doesn't boot thinking it's
# build-time.  systemd-timesyncd will sync from NTP after the first network
# connection instead of anchoring to a stale build-machine timestamp.
rm -f /var/lib/systemd/timesync/clock
